CM_ "CANabstractCAR DBC file for openpilot car port";
CM_ "Message 0x44: Vehicle status at 5Hz minimum";
CM_ "Message 0x46: Buttons and pedals at 5Hz minimum";

BO_ 68 VEHICLE_STATUS: 8 XXX
